# CivicFix Backend Environment Configuration
# Copy this file to .env and fill in your values

# Port on which the Express server will listen
PORT=5000

# MongoDB connection string (local instance or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/civicfix

# Secret key used for signing JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here

# Frontend origin URL for Cross-Origin Resource Sharing (CORS)
CLIENT_URL=http://localhost:5173

# Admin user credentials for server/scripts/createAdmin.js
ADMIN_EMAIL=admin@civicfix.org
ADMIN_PASSWORD=adminpassword123

# Cloudinary configuration for media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
