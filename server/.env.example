# CivicFix Backend Environment Configuration
# Copy this file to .env and fill in your values
# For production (Render), configure these variables in the Render dashboard

# Node environment mode (development / production)
NODE_ENV=development

# Port on which the Express server will listen (Render sets this automatically)
PORT=5000

# MongoDB connection string (local instance or MongoDB Atlas cluster URI)
MONGO_URI=mongodb://localhost:27017/civicfix

# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here

# Frontend origin URL(s) for Cross-Origin Resource Sharing (CORS)
# Supports one or more comma-separated origins (e.g., local Vite dev and Vercel production)
CLIENT_URL=http://localhost:5173,https://civicfix.vercel.app

# Default administrator credentials for seeding or scripts/createAdmin.js
ADMIN_EMAIL=admin@civicfix.org
ADMIN_PASSWORD=adminpassword123

# Cloudinary configuration for photo evidence upload storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
